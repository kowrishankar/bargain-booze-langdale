generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum FulfillmentType {
  COLLECTION
  DELIVERY
}

enum PaymentMethod {
  STRIPE
  PAY_IN_STORE
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_COLLECTION
  DELIVERED
  COLLECTED
  CANCELLED
}

enum PromotionType {
  BOGOF
  TWO_FOR_PRICE
  THREE_FOR_PRICE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  category    String
  stock       Int         @default(0)
  archived    Boolean     @default(false)
  promotionId String?
  promotion   Promotion?  @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Promotion {
  id        String        @id @default(cuid())
  name      String
  type      PromotionType
  dealPrice Float?
  active    Boolean       @default(true)
  products  Product[]
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model AllowedPostcode {
  id        String   @id @default(cuid())
  postcode  String   @unique
  area      String?
  createdAt DateTime @default(now())
}

model Order {
  id              String               @id @default(cuid())
  orderNumber     String               @unique
  userId          String
  user            User                 @relation(fields: [userId], references: [id])
  status          OrderStatus          @default(PENDING_PAYMENT)
  fulfillmentType FulfillmentType
  paymentMethod   PaymentMethod        @default(STRIPE)
  contactName     String
  contactEmail    String
  contactPhone    String
  addressLine1    String?
  addressLine2    String?
  city            String?
  postcode        String?
  subtotal        Float
  deliveryFee     Float                @default(0)
  discount        Float                @default(0)
  total           Float
  stripeSessionId String?
  stripePaymentId String?
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  productName      String
  unitPrice        Float
  quantity         Int
  lineTotal        Float
  promotionApplied String?
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}
